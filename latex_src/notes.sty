% Headers
% --- e-reader geometry (tunable knob for the Ralph loop) ---
% Small page + unchanged 10pt font => text is large relative to a 6" screen.
% Kindle Paperwhite 10th gen usable panel ~= 3.573in x 4.826in (257.3x347.5pt).
\usepackage[paperwidth=3.573in, paperheight=4.826in, includehead, includefoot,
  heightrounded, margin=0.10in, headsep=2pt, footskip=10pt]{geometry}
\setlength{\emergencystretch}{3em}  % relieve overfull lines from the narrow column
% --- Ralph loop Lever 1: shrink DISPLAY math only (not inline, not body prose) ---
% A LaTeX pt is absolute; on the 257pt-wide page wide display equations overflow.
% Rendering display math one size down (\small ~= 9pt) narrows multi-term lines so
% they fit the column while body prose stays ~10pt. Appended (expandafter) so any
% amsmath everydisplay tokens are preserved. Inline math is untouched.
\AtBeginDocument{\everydisplay\expandafter{\the\everydisplay\small}}
% --- Ralph loop Lever 2: auto-fit wide UNNUMBERED display math to the column ---
% align*/equation* bodies wider than \linewidth are uniformly scaled down with
% \resizebox (stays vector, correct & selectable); bodies that already fit keep
% their natural \small size untouched. Numbered envs (align/equation) are handled
% separately because the (n) tag needs reserved horizontal space.
\usepackage{environ}
\newsavebox\rlfitbox
\newcommand\rlfit[1]{%
  \sbox\rlfitbox{#1}%
  \ifdim\wd\rlfitbox>\linewidth
    \resizebox{\linewidth}{!}{\usebox\rlfitbox}%
  \else
    \usebox\rlfitbox
  \fi}
% Emit a centered display of the (possibly resized) box. We avoid \[ ... \]
% because in this preamble \[ maps to equation*, which our environ redefinition
% would re-trigger and mis-nest. \centerline builds the display manually.
\newcommand\rldisplay[1]{\par\addvspace{\abovedisplayskip}%
  \centerline{\rlfit{#1}}\addvspace{\belowdisplayskip}}
% Deferred: amsmath (which defines align*/equation*) loads later in this file.
\AtBeginDocument{%
  \RenewEnviron{align*}{\rldisplay{$\small\displaystyle\begin{aligned}\BODY\end{aligned}$}}%
}
