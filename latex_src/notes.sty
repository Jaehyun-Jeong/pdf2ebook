% Headers
% --- e-reader geometry (tunable knob for the Ralph loop) ---
% Small page + unchanged 10pt font => text is large relative to a 6" screen.
% Kindle Paperwhite 10th gen usable panel ~= 3.573in x 4.826in (257.3x347.5pt).
\usepackage[paperwidth=3.573in, paperheight=4.826in, includehead, includefoot,
  heightrounded, margin=0.10in, headsep=2pt, footskip=10pt]{geometry}
\setlength{\emergencystretch}{3em}  % relieve overfull lines from the narrow column
% --- Ralph loop Lever 1: shrink DISPLAY math only (not inline, not body prose) ---
% A LaTeX pt is absolute; on the 257pt-wide page wide display equations overflow.
% Rendering display math one size down (\small ~= 9pt) narrows multi-term lines so
% they fit the column while body prose stays ~10pt. Appended (expandafter) so any
% amsmath everydisplay tokens are preserved. Inline math is untouched.
\AtBeginDocument{\everydisplay\expandafter{\the\everydisplay\small}}
% --- Ralph loop Lever 2: auto-fit wide UNNUMBERED display math to the column ---
% align*/equation* bodies wider than \linewidth are uniformly scaled down with
% \resizebox (stays vector, correct & selectable); bodies that already fit keep
% their natural \small size untouched. Numbered envs (align/equation) are handled
% separately because the (n) tag needs reserved horizontal space.
\usepackage{environ}
\newsavebox\rlfitbox
\newcommand\rlfit[1]{%
  \sbox\rlfitbox{#1}%
  \ifdim\wd\rlfitbox>\linewidth
    \resizebox{\linewidth}{!}{\usebox\rlfitbox}%
  \else
    \usebox\rlfitbox
  \fi}
% Emit a centered display of the (possibly resized) box. We avoid \[ ... \]
% because in this preamble \[ maps to equation*, which our environ redefinition
% would re-trigger and mis-nest. \centerline builds the display manually.
\newcommand\rldisplay[1]{\par\addvspace{\abovedisplayskip}%
  \centerline{\rlfit{#1}}\addvspace{\belowdisplayskip}}
% Lever 2c (equation half): auto-fit NUMBERED `equation`. Unlike align*/equation*
% we must keep the (n) tag full-size in the right margin, so we cannot wrap the
% whole env in \resizebox (which would shrink the number too) and we cannot box a
% display environment. Instead we invoke the ORIGINAL equation env (saved via
% \let to avoid environ recursion) and place an auto-fitted hbox of its body as
% the math content; the env appends the number at full size. The body is scaled
% only when wider than (\linewidth - number reserve), so equations that already
% fit are untouched. Reserve ~26pt for the "(nnn)" tag at \small.
\newsavebox\rlnumbox
\newcommand\rlfitnum[1]{%
  \sbox\rlnumbox{#1}%
  \ifdim\wd\rlnumbox>\dimexpr\linewidth-26pt\relax
    \resizebox{\dimexpr\linewidth-26pt\relax}{!}{\usebox\rlnumbox}%
  \else
    \usebox\rlnumbox
  \fi}
% Lever 2c (align half): auto-fit NUMBERED `align`. amsmath's align is NOT a
% simple begin/end pair (it is built on \halign via \start@align), so unlike
% `equation` it cannot be re-entered by \let-ing its begin/end macros, nor can a
% multi-row body (with &/\\) be boxed without destroying its alignment + numbers.
% Strategy: detect whether \BODY contains a row break \\.
%   * SINGLE-row (no \\): numerically identical to an `equation` (same equation
%     counter, one number), so route it through the proven equation machinery —
%     box the body in an \aligned (to keep any inner & alignment), \resizebox it
%     to the column when wider, and let equation emit the (n) at full size.
%   * MULTI-row (has \\): leave it exactly as native align by invoking a CLONE of
%     the genuine environment (\begin{rlgenalign}...) so per-row numbering and the
%     &-alignment are untouched. (Verified the clone preserves the equation count.)
% Lever 2d: auto-fit UNNUMBERED \[ ... \] displays. amsmath maps \[...\] to
% equation*, which we cannot redefine via environ (it is also used inside
% mdframed theorem boxes and environ mis-scans across them). Instead capture the
% body in an hbox at display style and emit it inside a plain $$...$$ display
% (which centers it and — unlike \centerline — keeps the surrounding paragraph
% continuing un-indented after \], exactly like native \[...\]). The captured
% box is \resizebox'd to \linewidth only when wider, so displays that already fit
% are untouched. \[...\] is single-line (no top-level \\ or & allowed), so an
% hbox is always valid; \\ nested inside array/pmatrix/cases is fine (verified).
\newsavebox\rldispbox
\newcommand\rldispstart{\setbox\rldispbox\hbox\bgroup$\small\displaystyle}
\newcommand\rldispend{$\egroup
  $$\ifdim\wd\rldispbox>\linewidth
     \resizebox{\linewidth}{!}{\usebox\rldispbox}\else\usebox\rldispbox\fi$$}
% \\-detection: append \\\rl@nilmark@ to (one expansion of) \BODY and grab the
% tokens after the FIRST \\; if that is exactly our marker, there was no real \\.
\newif\ifrl@multi
\long\def\rl@splitbb#1\\#2\rl@END{\def\rl@rest{#2}}
\def\rl@onlymark{\rl@nilmark@}
\def\rl@detectbreak{%
  \expandafter\rl@splitbb\BODY\\\rl@nilmark@\rl@END
  \ifx\rl@rest\rl@onlymark\rl@multifalse\else\rl@multitrue\fi}
% Deferred: amsmath (which defines align*/equation*/equation) loads later.
\AtBeginDocument{%
  \RenewEnviron{align*}{\rldisplay{$\small\displaystyle\begin{aligned}\BODY\end{aligned}$}}%
  % Lever 2b: alignat* takes a mandatory {n} column-count arg; absorb it (#1) and
  % let \aligned handle the &/&& alignment (incl. the \blacktriangleright &&\text
  % margin annotations on p24/p30). Same auto-fit-to-\linewidth treatment as 2a.
  \RenewEnviron{alignat*}[1]{\rldisplay{$\small\displaystyle\begin{aligned}\BODY\end{aligned}$}}%
  % Lever 2c: numbered equation. Save the genuine env, then re-enter it with an
  % auto-fitted body so the (n) tag is emitted by amsmath at full size in margin.
  \let\rloldequation\equation
  \let\rloldendequation\endequation
  \RenewEnviron{equation}{\rloldequation\rlfitnum{$\small\displaystyle\BODY$}\rloldendequation}%
  % Lever 2c (align half): clone genuine align under a private name for the
  % multi-row pass-through, then redefine align to auto-fit only single-row.
  \expandafter\let\csname rlgenalign\endcsname\align
  \expandafter\let\csname endrlgenalign\endcsname\endalign
  \RenewEnviron{align}{%
    \rl@detectbreak
    \ifrl@multi
      \begin{rlgenalign}\BODY\end{rlgenalign}%
    \else
      \rloldequation\rlfitnum{$\small\displaystyle\begin{aligned}\BODY\end{aligned}$}\rloldendequation
    \fi}%
  % amsmath shares one end routine: \endalignat and \endflalign are literally
  % "\endalign". Redefining the align environment above clobbered \endalign with
  % environ's cleanup, which would break the (numbered) alignat used in part_04.
  % Repoint those siblings at the saved genuine end so they close normally.
  \expandafter\let\expandafter\endalignat\csname endrlgenalign\endcsname
  \expandafter\let\expandafter\endflalign\csname endrlgenalign\endcsname
  % Lever 2d: auto-fit unnumbered \[ ... \] display math (see above).
  \def\[{\rldispstart}%
  \def\]{\rldispend}%
}
